# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# MongoDB. Use separate databases for synthetic demo data and the real register.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lagos_eip_demo

# 32-byte keys as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# RECORD_HASH_KEY pseudonymises VINs/names. Back it up securely: if lost, VIN lookups stop working
# and the register must be re-imported. If leaked, rotate it and re-import.
RECORD_HASH_KEY=
# Encrypts MFA secrets at rest.
APP_ENCRYPTION_KEY=

SESSION_TTL_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# true when served over HTTPS (required in production)
COOKIE_SECURE=false

# Restricted source folder (read-only access is sufficient). Never inside web/public.
SOURCE_DATA_DIR=./DONE
INGEST_MEMORY_LIMIT_MB=700
INGEST_BATCH_SIZE=1000

# Cloudinary (server-side only — never prefix with VITE_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lagos-eip

RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_API_PER_MIN=300

# Local MongoDB helper (npm run db:local)
# LOCAL_MONGO_DBPATH=C:\Users\<you>\AppData\Local\LagosEIP\mongodb
# LOCAL_MONGO_CACHE_GB=0.25

# Fallback extractor for damaged PDFs (python -m venv .venv && .venv\Scripts\pip install pypdf pikepdf)
INGEST_PYTHON=.venv/Scripts/python.exe

# Set true to turn off authenticator codes (email + password only)
DISABLE_MFA=false
